{
  "name": "@open-agents/server",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless Hono HTTP API and Pull-Initiated Push server for OpenAgents",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
